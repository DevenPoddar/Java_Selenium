package com.Day3;

import java.io.FileInputStream;
import java.io.IOException;
import java.time.Duration;
import java.util.Properties;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class LogIntoGmail {

	public static void main(String[] args) throws IOException {
		// Load properties (update path and keys)
		Properties props = new Properties();
		FileInputStream fis = new FileInputStream(
				"D:/Github/Java_Selenium/Selenium/src/test/resources/gmail.properties.txt");
		props.load(fis);

		String email = props.getProperty("gmail.email");
		String password = props.getProperty("gmail.password");

		WebDriver driver = new ChromeDriver();
		WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(20));

		try {
			// Go to Gmail sign-in
			driver.get("https://accounts.google.com/signin/v2/identifier?service=mail");

			// Enter email
			WebElement emailInput = wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("identifierId")));
			emailInput.sendKeys(email);

			WebElement emailNextBtn = driver.findElement(By
					.xpath("//div[@id='identifierNext']//button[@type='button' or @type='submit' or @role='button']"));
			emailNextBtn.click();

			// Enter password
			WebElement passwordInput = wait.until(ExpectedConditions.visibilityOfElementLocated(By.name("Passwd")));
			passwordInput.sendKeys(password);

			WebElement pwdNextBtn = driver.findElement(
					By.xpath("//div[@id='passwordNext']//button[@type='button' or @type='submit' or @role='button']"));
			pwdNextBtn.click();

			// Wait for Gmail inbox to load (title or URL check)
			wait.until(ExpectedConditions.or(ExpectedConditions.urlContains("mail.google.com/mail"),
					ExpectedConditions.titleContains("Inbox")));

			System.out.println("Logged into Gmail successfully.");
		} finally {
			// driver.quit(); // Uncomment if you want to close after verification
		}
	}
}
