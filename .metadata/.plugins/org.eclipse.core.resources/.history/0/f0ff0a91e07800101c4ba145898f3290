package com.Day3;

import java.io.File;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class ResumeUpload {
	public static void main(String[] args) {

		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();

		try {
			driver.get(
					"https://www.monster.com/profile/onboarding/upload?redirectUri=%2Fprofile%2Fdetail%3FsignUpFlow%3DRESUME_UPLOAD&signUpFlow=RESUME_UPLOAD");
			File resume = new File("C:/Users/2002d/Downloads/Linux1/Documents/Deven Final Learning.pdf");
			WebElement uploadResume = driver.findElement(By.cssSelector("input[type='file']"));
			uploadResume.sendKeys(resume.getAbsolutePath());
			driver.findElement(By.id("attachCV")).click();

			System.out.println("Uploaded: ");
		} finally {
			driver.quit();
		}

	}
}
