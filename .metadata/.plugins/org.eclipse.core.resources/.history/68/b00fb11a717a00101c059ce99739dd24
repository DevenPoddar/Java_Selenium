package com.Day4;

import java.util.ArrayList;
import java.util.List;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class AddProductsFlipkart {
	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.get("https://www.myntra.com");

		List<String> products = new ArrayList<>();
		products.add("shirts");
		products.add("sneakers");
		products.add("jeans");

		for (String product : products) {
			// Find search box and input product
			WebElement searchBox = driver.findElement(By.className("desktop-searchBar"));
			searchBox.clear();
			searchBox.sendKeys(product);
			driver.findElement(By.className("desktop-submit")).click();
			Thread.sleep(3000); // Wait for search results

			// Select the first product
			List<WebElement> items = driver.findElements(By.cssSelector("li.product-base"));
			if (!items.isEmpty()) {
				items.get(0).click();
				Thread.sleep(2000);

				// Switch to new tab for product detail page
				ArrayList<String> tabs = new ArrayList<>(driver.getWindowHandles());
				driver.switchTo().window(tabs.get(tabs.size() - 1));

				// Click 'Add to bag' (cart)
				WebElement addToBag = driver
						.findElement(By.xpath("//div[@class='pdp-add-to-bag pdp-button pdp-flex pdp-center']/div"));
				addToBag.click();

				Thread.sleep(2000);
				driver.close(); // Close product tab
				driver.switchTo().window(tabs.get(0)); // Back to main
			} else {
				System.out.println("No products found for: " + product);
			}
		}

		// Go to cart (bag)
		driver.findElement(By.xpath("//span[text()='Bag']")).click();
		Thread.sleep(3000);

		// Proceed to checkout
		driver.findElement(By.xpath("//div[text()='PLACE ORDER']")).click();
		Thread.sleep(3000);

		driver.quit();
	}
}
