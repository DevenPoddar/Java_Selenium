package com.Day4;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;

public class AddProductsMyntra {
	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.get("https://www.myntra.com/");
		Thread.sleep(2000);

		WebElement menMenu = driver.findElement(By.className("desktop-userTitle"));
		Actions actions = new Actions(driver);
		actions.moveToElement(menMenu).perform();

		driver.findElement(By.className("desktop-linkButton")).click();
		Thread.sleep(1000);
		driver.findElement(By.cssSelector(
				"#reactPageContent > div > div > div.signInContainer > div.mobileInputContainer > div.form-group > input"))
				.sendKeys("9163558125");
		driver.findElement(By.className("consentCheckbox")).click();
		driver.findElement(By.className("submitBottomOption")).click();

		System.out.println("Enter the OTP you received on your phone: ");
		Scanner sc = new Scanner(System.in);
		String otp = sc.nextLine();
		driver.findElement(By.className("otpContainer")).sendKeys(otp);
		// driver.findElement(By.cssSelector("button.btn-filled")).click();
		Thread.sleep(3000);

		List<String> products = new ArrayList<>();
		products.add("shoes");
		products.add("tshirt");
		products.add("jeans");
		for (String product : products) {
			WebElement searchBox = driver.findElement(By.className("desktop-searchBar"));
			searchBox.clear();
			searchBox.sendKeys(product);
			driver.findElement(By.className("desktop-submit")).click();
			Thread.sleep(3000);

			List<WebElement> items = driver.findElements(By.cssSelector("li.product-base"));
			if (items.size() > 0) {
				items.get(0).click();
				Thread.sleep(2000);
				ArrayList<String> tabs = new ArrayList<>(driver.getWindowHandles());
				driver.switchTo().window(tabs.get(tabs.size() - 1));
				List<WebElement> sizes = driver.findElements(By.cssSelector("div.size-buttons-buttonContainer button"));
				if (sizes.size() > 0) {
					sizes.get(0).click();
				}
				Thread.sleep(500);
				driver.findElement(By.xpath("//button[.='ADD TO BAG']")).click();
				Thread.sleep(1000);
				driver.close();
				driver.switchTo().window(tabs.get(0));
			}
		}

		driver.findElement(By.cssSelector("span.myntraweb-sprite.cartIcon")).click();
		Thread.sleep(2000);

		driver.findElement(By.xpath("//button[.='PLACE ORDER']")).click();
		Thread.sleep(3000);

		sc.close();
		driver.quit();
	}
}
